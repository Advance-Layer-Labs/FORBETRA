generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INDIVIDUAL
  COACH
  ADMIN
  ORG_ADMIN
}

enum OrgRole {
  MEMBER
  ORG_ADMIN
}

enum JourneyStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum ReviewerCadence {
  WEEKLY
  BIWEEKLY
}

enum ReviewerAttribution {
  REVIEWER
  COACH
}

enum TokenType {
  AUTH_MAGIC_LINK
  FEEDBACK_INVITE
  RESET_PASSWORD
  COACH_INVITE
}

enum InsightType {
  CHECK_IN
  WEEKLY_SYNTHESIS
  COACH_PREP
  COACH_ALERT
  JOURNEY_REPORT
}

enum InsightStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

model User {
  id                         String    @id @default(cuid())
  clerkUserId                String?   @unique
  email                      String    @unique
  name                       String?
  role                       UserRole  @default(INDIVIDUAL)
  phone                      String?
  timezone                   String?
  notificationTime           String?
  deliveryMethod             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  coachOnboardingCompletedAt DateTime?
  lastSeenAt                 DateTime?
  focusAreaPromptAt          DateTime?

  goals                    Goal[]
  journeys                 Journey[]
  checkIns                 CheckIn[]
  reviewers                Reviewer[]           @relation("IndividualReviewers")
  reviewerAccount          Reviewer[]           @relation("ReviewerAccount")
  reviewersInvited         Reviewer[]           @relation("ReviewerInviter")
  coachNotesAuthored       CoachNote[]          @relation("CoachNotesAuthored")
  coachNotesReceived       CoachNote[]          @relation("CoachNotesReceived")
  tokens                   Token[]              @relation("UserTokens")
  coachClientsManaged      CoachClient[]        @relation("CoachClientsCoach")
  coachClientsOwned        CoachClient[]        @relation("CoachClientsIndividual")
  coachInvitationsSent     CoachInvite[]        @relation("CoachInvites")
  coachInvitationsLinked   CoachInvite[]        @relation("CoachInviteIndividual")
  insights                 Insight[]
  organizationMemberships  OrganizationMember[]
  goalChanges              GoalChange[]
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  focusAreas FocusArea[]
  journeys   Journey[]
  reviewers  Reviewer[]
  changes    GoalChange[]

  @@index([userId])
}

model GoalChange {
  id            String   @id @default(cuid())
  goalId        String
  userId        String
  previousTitle String
  newTitle      String
  previousDesc  String?
  newDesc       String?
  reason        String?
  createdAt     DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

model FocusArea {
  id          String   @id @default(cuid())
  goalId      String
  label       String
  description String?
  order       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Journey {
  id          String        @id @default(cuid())
  userId      String
  goalId      String
  label       String?
  startDate   DateTime
  endDate     DateTime?
  lengthWeeks Int           @default(12)
  status      JourneyStatus @default(PLANNED)
  summary     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkIns   CheckIn[]
  feedback   Feedback[]
  coachNotes CoachNote[]
  insights   Insight[]
  tokens     Token[]

  @@index([userId])
  @@index([goalId])
  @@index([status])
}

model CheckIn {
  id               String   @id @default(cuid())
  journeyId        String
  userId           String
  effortScore      Int
  performanceScore Int
  notes            String?
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([userId])
  @@index([submittedAt])
}

model Reviewer {
  id            String               @id @default(cuid())
  individualId  String
  goalId        String?
  userId        String?
  invitedById   String?
  name          String
  email         String
  phone         String?
  relationship  String?
  cadence       ReviewerCadence      @default(WEEKLY)
  attribution   ReviewerAttribution  @default(REVIEWER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  individual User      @relation("IndividualReviewers", fields: [individualId], references: [id], onDelete: Cascade)
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  account    User?     @relation("ReviewerAccount", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy  User?     @relation("ReviewerInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  feedback   Feedback[]
  tokens     Token[]

  @@unique([individualId, email])
  @@index([goalId])
  @@index([userId])
}

model Feedback {
  id                    String   @id @default(cuid())
  journeyId             String
  reviewerId            String
  weekNumber            Int
  effortScore           Int?
  performanceScore      Int?
  comment               String?
  behavioralObservation String?
  suggestion            String?
  submittedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  journey  Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  reviewer Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, journeyId, weekNumber])
  @@index([journeyId])
  @@index([reviewerId])
}

model CoachNote {
  id           String   @id @default(cuid())
  coachId      String
  individualId String
  journeyId    String?
  weekNumber   Int?
  content      String
  createdAt    DateTime @default(now())

  coach      User     @relation("CoachNotesAuthored", fields: [coachId], references: [id], onDelete: Cascade)
  individual User     @relation("CoachNotesReceived", fields: [individualId], references: [id], onDelete: Cascade)
  journey    Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([individualId])
  @@index([journeyId])
}

model Token {
  id         String    @id @default(cuid())
  type       TokenType
  tokenHash  String    @unique
  userId     String?
  reviewerId String?
  journeyId  String?
  weekNumber Int?
  expiresAt  DateTime
  usedAt     DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user     User?     @relation("UserTokens", fields: [userId], references: [id], onDelete: Cascade)
  reviewer Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  journey  Journey?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@index([reviewerId])
  @@index([journeyId])
}

model CoachClient {
  id           String    @id @default(cuid())
  coachId      String
  individualId String
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  coach      User @relation("CoachClientsCoach", fields: [coachId], references: [id], onDelete: Cascade)
  individual User @relation("CoachClientsIndividual", fields: [individualId], references: [id], onDelete: Cascade)

  @@unique([coachId, individualId])
  @@index([coachId])
  @@index([individualId])
}

model Insight {
  id         String        @id @default(cuid())
  userId     String
  journeyId  String?
  weekNumber Int?
  type       InsightType
  status     InsightStatus @default(PENDING)
  content    String?
  promptHash String?
  modelId    String?
  thumbs     Int?
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@unique([userId, journeyId, weekNumber, type])
  @@index([userId])
  @@index([journeyId])
  @@index([type, status])
}

model CoachInvite {
  id           String    @id @default(cuid())
  coachId      String
  email        String
  name         String?
  phone        String?
  message      String?
  payload      Json?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  cancelledAt  DateTime?
  individualId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  coach      User  @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)
  individual User? @relation("CoachInviteIndividual", fields: [individualId], references: [id], onDelete: SetNull)

  @@unique([coachId, email], map: "CoachInvite_coachId_email_key")
  @@index([coachId])
  @@index([email])
}

model NotificationCap {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}
